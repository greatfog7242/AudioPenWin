<Application
    x:Class="AudioPenWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Speaker label color palette (matches Android 6-color palette) -->
            <SolidColorBrush x:Key="Speaker0Brush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="Speaker1Brush" Color="#10B981"/>
            <SolidColorBrush x:Key="Speaker2Brush" Color="#F59E0B"/>
            <SolidColorBrush x:Key="Speaker3Brush" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="Speaker4Brush" Color="#EF4444"/>
            <SolidColorBrush x:Key="Speaker5Brush" Color="#06B6D4"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
