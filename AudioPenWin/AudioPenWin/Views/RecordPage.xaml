<Page
    x:Class="AudioPenWin.Views.RecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AudioPenWin.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="BtnTransform"
                Storyboard.TargetProperty="ScaleX"
                From="1.0" To="1.12"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="BtnTransform"
                Storyboard.TargetProperty="ScaleY"
                From="1.0" To="1.12"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Button Grid.Row="0" Content="← Back" HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="16" Click="Back_Click"/>

        <!-- Waveform -->
        <controls:WaveformControl x:Name="Waveform" Grid.Row="1"
                                  Margin="24,16" MinHeight="100" VerticalAlignment="Center"/>

        <!-- Controls -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,52" Spacing="20">
            <TextBlock x:Name="TbTimer" Text="0:00"
                       Style="{StaticResource SubheaderTextBlockStyle}"
                       HorizontalAlignment="Center"/>

            <Button x:Name="BtnRecord" Width="72" Height="72" CornerRadius="36"
                    HorizontalAlignment="Center" Click="Record_Click"
                    Background="#E53935" Foreground="White">
                <Button.RenderTransform>
                    <CompositeTransform x:Name="BtnTransform" CenterX="36" CenterY="36"/>
                </Button.RenderTransform>
                <!-- Circle = ready to record; Square = stop -->
                <Rectangle x:Name="RecordIcon" Width="24" Height="24" RadiusX="12" RadiusY="12" Fill="White"/>
            </Button>
        </StackPanel>
    </Grid>
</Page>
