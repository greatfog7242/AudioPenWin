<Page
    x:Class="AudioPenWin.Views.PlaybackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AudioPenWin.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Padding="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                    ToolTipService.ToolTip="Back" Click="Back_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>

            <TextBox x:Name="TitleBox"
                     Grid.Column="1"
                     Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="12,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     FontSize="16"
                     LostFocus="TitleBox_LostFocus"
                     KeyDown="TitleBox_KeyDown"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnRetry"
                        Visibility="Collapsed"
                        Click="Retry_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="Retry"/>
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Export transcript and audio" Click="Export_Click">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14"/>
                </Button>
                <Button ToolTipService.ToolTip="Open in Explorer" Click="OpenFolder_Click">
                    <FontIcon Glyph="&#xED25;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Content (video + transcript) ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Video player (VIDEO_IMPORT only) -->
            <MediaPlayerElement x:Name="Player"
                                Grid.Row="0"
                                AreTransportControlsEnabled="False"
                                Stretch="Uniform"
                                MaxHeight="280"/>

            <!-- Transcript / status area -->
            <Grid Grid.Row="1">

                <!-- Transcribing spinner -->
                <StackPanel x:Name="SpinnerPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TbStatus"
                               Style="{StaticResource BodyTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- Failed placeholder -->
                <StackPanel x:Name="FailedPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            MaxWidth="480" Margin="24,0"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE730;" FontSize="44"
                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Transcription failed"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TbErrorMessage"
                               Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="Tap Retry above to try again"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- Transcript (built in code-behind) -->
                <ScrollViewer x:Name="TranscriptScroll"
                              Padding="20,10,20,10"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              Visibility="Collapsed">
                    <RichTextBlock x:Name="TranscriptBlock"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   LineHeight="30"
                                   IsTextSelectionEnabled="False"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== Transport Controls ===== -->
        <Border Grid.Row="2"
                Padding="20,12,20,18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">

                <!-- Seek row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TbPosition" Grid.Column="0"
                               Text="0:00"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,4,0"/>
                    <Slider x:Name="SeekSlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="1000"
                            StepFrequency="1"
                            ValueChanged="SeekSlider_ValueChanged"/>
                    <TextBlock x:Name="TbDuration" Grid.Column="2"
                               Text="0:00"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="4,0,0,0"/>
                </Grid>

                <!-- Playback buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button Width="44" Height="44" CornerRadius="22"
                            ToolTipService.ToolTip="Back 10 seconds (←)" Click="Rewind_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left"/>
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xED3C;" FontSize="18"/>
                    </Button>

                    <Button x:Name="BtnPlayPause"
                            Width="54" Height="54" CornerRadius="27"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="PlayPause_Click"
                            ToolTipService.ToolTip="Play / Pause (Space)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Space"/>
                        </Button.KeyboardAccelerators>
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20"/>
                    </Button>

                    <Button Width="44" Height="44" CornerRadius="22"
                            ToolTipService.ToolTip="Forward 10 seconds (→)" Click="Forward_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Right"/>
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xED3D;" FontSize="18"/>
                    </Button>

                    <ComboBox x:Name="SpeedBox"
                              Width="80"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Playback speed"
                              SelectionChanged="SpeedBox_SelectionChanged">
                        <ComboBoxItem Content="0.75&#xD7;" Tag="0.75"/>
                        <ComboBoxItem Content="1.0&#xD7;" Tag="1.0" IsSelected="True"/>
                        <ComboBoxItem Content="1.25&#xD7;" Tag="1.25"/>
                        <ComboBoxItem Content="1.5&#xD7;" Tag="1.5"/>
                        <ComboBoxItem Content="2.0&#xD7;" Tag="2.0"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
