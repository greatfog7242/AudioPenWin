<Page
    x:Class="AudioPenWin.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AudioPenWin.ViewModels"
    xmlns:conv="using:AudioPenWin.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Import busy overlay — spans all rows, shown while FFmpeg is running -->
        <Grid x:Name="ImportOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Opacity="0.92"
              Canvas.ZIndex="99">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="52" Height="52"/>
                <TextBlock x:Name="ImportStatusText"
                           Text="Importing…"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="AudioPen" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                    ToolTipService.ToolTip="Settings" Click="Settings_Click">
                <FontIcon Glyph="&#xE713;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Search box -->
        <AutoSuggestBox Grid.Row="1" x:Name="SearchBox"
                        PlaceholderText="Search recordings…"
                        Margin="24,12,24,8"
                        QueryIcon="Find"
                        TextChanged="Search_TextChanged"/>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE7EE;" FontSize="56"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="No recordings yet"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Tap + to start recording or import a file"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Recording list -->
            <ListView x:Name="RecordingList"
                      ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="RecordingList_ItemClick"
                      Padding="24,4,24,100"
                      RightTapped="RecordingList_RightTapped"
                      Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecordingCardViewModel">
                        <Border Padding="16" CornerRadius="8" Margin="0,4,0,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Source type icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind SourceIcon}"
                                           FontSize="28"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>

                                <!-- Title + date -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DateText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Duration + status badge -->
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            MinWidth="70"
                                            Spacing="4">
                                    <TextBlock Text="{x:Bind DurationText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               HorizontalAlignment="Right"/>
                                    <Border Background="{x:Bind StatusBrush, Mode=OneWay}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- FABs -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,24"
                        Spacing="12">
                <Button x:Name="BtnImport"
                        Width="48" Height="48" CornerRadius="24"
                        ToolTipService.ToolTip="Import audio or video file"
                        Click="Import_Click">
                    <FontIcon Glyph="&#xE898;" FontSize="18"/>
                </Button>
                <Button x:Name="BtnRecord"
                        Width="64" Height="64" CornerRadius="32"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="New recording (Ctrl+R)"
                        Click="Record_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE720;" FontSize="26"/>
                </Button>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
